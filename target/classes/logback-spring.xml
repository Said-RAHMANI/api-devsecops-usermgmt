<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ── Spring Boot default base config (console + file appenders) ───────── -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="APP_NAME"
                    source="spring.application.name"
                    defaultValue="api-devsecops-usermgmt"/>

    <!-- ── JSON Console Appender (ELK-compatible) ────────────────────────────── -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Core fields -->
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <!-- Service identifier for Kibana filtering -->
            <customFields>{"service":"${APP_NAME}"}</customFields>
            <!-- Include MDC fields: traceId, requestId, path, method, duration -->
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>path</includeMdcKeyName>
            <includeMdcKeyName>method</includeMdcKeyName>
            <includeMdcKeyName>duration</includeMdcKeyName>
            <!-- Full exception with stack trace -->
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerCause>20</maxDepthPerCause>
                <shortenedClassNameLength>30</shortenedClassNameLength>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <!-- ── Plain Console (development profile only) ──────────────────────────── -->
    <appender name="PLAIN_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ── Rolling JSON File Appender ────────────────────────────────────────── -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/application.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${APP_NAME}"}</customFields>
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>path</includeMdcKeyName>
            <includeMdcKeyName>method</includeMdcKeyName>
            <includeMdcKeyName>duration</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- ── Profile: default / staging / production → JSON output ─────────────── -->
    <springProfile name="!dev">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
            <appender-ref ref="JSON_FILE"/>
        </root>
        <!-- Reduce noise from Hibernate and Spring internals -->
        <logger name="org.hibernate.SQL"                   level="WARN"/>
        <logger name="org.springframework.security"        level="WARN"/>
        <logger name="org.springframework.web"             level="INFO"/>
        <logger name="com.devsecops.usermgmt"              level="DEBUG"/>
    </springProfile>

    <!-- ── Profile: dev → human-readable output ──────────────────────────────── -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="PLAIN_CONSOLE"/>
        </root>
        <logger name="com.devsecops.usermgmt" level="DEBUG"/>
        <logger name="org.hibernate.SQL"       level="DEBUG"/>
    </springProfile>

</configuration>
